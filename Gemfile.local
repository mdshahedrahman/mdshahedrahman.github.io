# Shared, locked dependencies for local preview and GitHub Pages deployment.
source "https://rubygems.org"

gem "jekyll", "~> 3.10.0"
gem "kramdown-parser-gfm", "~> 1.1"
gem "liquid", "~> 4.0", ">= 4.0.4"
gem "csv", "~> 3.3"
gem "bigdecimal", "~> 3.1"
gem "base64", "~> 0.3"
gem "logger", "~> 1.7"
gem "webrick", "~> 1.8"
gem "jekyll-paginate", "~> 1.1"
gem "jekyll-sitemap", "~> 1.4"
gem "jekyll-gist", "~> 1.5"
gem "jekyll-feed", "~> 0.17"
gem "jekyll-redirect-from", "~> 0.16"
